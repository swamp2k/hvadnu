{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hvadnu",
  "main": "./src/server/worker.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "keep_vars": true,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DOCUMENT_ANALYSIS_ENABLED": "true",
    "PRIVATE_DEPLOYMENT_APPROVED": "true",
    "ANTHROPIC_ZDR_APPROVED": "true",
    "PAYLOAD_LOGGING_DISABLED": "true",
    "TEAM_DOMAIN": "https://hadus.cloudflareaccess.com",
    "POLICY_AUD": "cbb2332bb7328a5f93247d480307014811f930b173e646852890d7aa85fb4d4a"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hvadnu-prod",
      "database_id": "a7dbc676-17b2-4a91-87c6-a98565d1ee5b"
    }
  ],
  "secrets": {
    "required": ["ANTHROPIC_API_KEY"]
  }
}
